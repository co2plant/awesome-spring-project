echo "Running code convention checks (pre-commit)"
set +e

# 1. Frontend - lint-staged (Prettier & ESLint)
echo "---------------------------------------"
echo "1/2 Frontend (Vite/React) formatting..."
cd frontend
npx lint-staged
FRONTEND_STATUS=$?
cd ..

# 2. Backend - Spotless (Google Java Format)
echo "---------------------------------------"
echo "2/2 Backend (Spring Boot) formatting..."
cd backend
if [ -f "gradle/wrapper/gradle-wrapper.jar" ] && [ -f "gradlew" ]; then
  ./gradlew spotlessApply
  BACKEND_STATUS=$?
else
  echo "Skipping backend Spotless: Gradle wrapper is missing (backend/gradle/wrapper/gradle-wrapper.jar)."
  BACKEND_STATUS=0
fi
cd ..

echo "---------------------------------------"
if [ $FRONTEND_STATUS -ne 0 ] || [ $BACKEND_STATUS -ne 0 ]; then
  echo "Code convention check failed. Please fix the errors above."
  exit 1
else
  echo "All code is formatted. Continuing commit..."
fi
