# Prod images (injected by Jenkins deploy stage as BACKEND_IMAGE/FRONTEND_IMAGE)
BACKEND_IMAGE=registry.example.com/awesome/awesome-backend:replace-me
FRONTEND_IMAGE=registry.example.com/awesome/awesome-frontend:replace-me

# Prod DB
PROD_POSTGRES_DB=awesome_prod
PROD_POSTGRES_USER=awesome_prod_user
PROD_POSTGRES_PASSWORD=change_me_prod
PROD_POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8

# Prod locale/time
PROD_TZ=Asia/Seoul
PROD_PGTZ=Asia/Seoul
PROD_LANG=C.UTF-8
PROD_LC_ALL=C.UTF-8

# Host path where certificate files are stored.
# Required files:
# - ${NGINX_CERTS_DIR}/fullchain.pem
# - ${NGINX_CERTS_DIR}/privkey.pem
NGINX_CERTS_DIR=/opt/awesome-spring-project/certs
